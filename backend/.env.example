# 数据库 & 数据目录：默认使用仓库根目录下的 data/audit.db 与 data/，一般无需设置
# DATABASE_URL=sqlite:////absolute/path/to/audit.db
# DATA_DIR=/absolute/path/to/data

# 外部端点（占位）
EMBED_URL=http://localhost:8081
EMBED_MODEL=BAAI/bge-m3
CHAT_URL=http://localhost:8000/v1
CHAT_MODEL=qwen3

# 内部微服务地址
C3RAG_SERVICE_URL=http://localhost:8101
TRACE_SERVICE_URL=http://localhost:8102

# LLM Key（本地可空）
OPENAI_API_KEY=sk-placeholder
