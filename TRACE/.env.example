# service.py reads these from the process environment (it does not load .env);
# export them or pass them via `env`. Paths are relative to the TRACE/ directory.
PORT=8102
EMBED_URL=http://localhost:8081/v1/embeddings
CHAT_URL=http://localhost:8000/v1/chat/completions
CHAT_MODEL=gpt-4o-mini
INDEX_DIR=../data/index/trace
