*.py[cod]
*$py.class
*.so

# Editor / OS
.vscode/
.cursor/
.claude/
.idea/
.DS_Store

# Python distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Environments
.venv/
venv/
env/
.env
.envrc

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

